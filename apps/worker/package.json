{
  "name": "@kidar/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "pipeline:demo": "tsx src/demo.ts",
    "fixture:popout": "tsx src/popout/run-fixture.ts",
    "fixture:mind": "tsx src/mindar/run-fixture.ts",
    "fixtures:linux": "node scripts/run-linux-fixtures.mjs",
    "storage:r2:verify": "tsx src/storage/verify-r2.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.787.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@imgly/background-removal-node": "1.4.5",
    "@kidar/core": "workspace:*",
    "canvas": "2.11.2",
    "mind-ar": "1.2.5",
    "node-appwrite": "29.0.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.180.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
