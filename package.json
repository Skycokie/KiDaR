{
  "name": "kidar-studio",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @kidar/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @kidar/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "appwrite:setup": "node scripts/setup-appwrite.mjs",
    "appwrite:verify": "node scripts/setup-appwrite.mjs --verify",
    "worker": "pnpm --filter @kidar/worker start",
    "pipeline:demo": "pnpm --filter @kidar/worker pipeline:demo"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ],
    "peerDependencyRules": {
      "ignoreMissing": ["vite"],
      "allowedVersions": {
        "vite": "*"
      }
    }
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.2"
  }
}
