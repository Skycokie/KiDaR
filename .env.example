# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6aaa61b4000e4035f26e
APPWRITE_API_KEY=

# Optional Appwrite resource overrides (defaults match APPWRITE.md)
APPWRITE_DATABASE_ID=kidar
APPWRITE_PROFILES_COLLECTION=profiles
APPWRITE_PROJECTS_COLLECTION=projects
APPWRITE_JOBS_COLLECTION=jobs
APPWRITE_SOURCE_BUCKET=source-drawings
APPWRITE_ASSETS_BUCKET=source-drawings

# Public consumer artifacts on Cloudflare R2 (server-side only; never NEXT_PUBLIC_*).
# R2_ENDPOINT is the S3 API host. R2_PUBLIC_BASE_URL is the HTTPS CDN/custom domain origin.
PUBLIC_ARTIFACT_STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kidar-public-ar
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# E2E-only (CI or intentional production smoke of e2e-session)
ALLOW_E2E_AUTH=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional, disabled unless configured
AI3D_PROVIDER=
AI3D_API_KEY=

# Figurină 3D (Tripo Image-to-3D) — server-only on the Hetzner worker.
# Do NOT set TRIPO_* on Vercel. Web uses FIGURINE_3D_ENABLED only.
TRIPO_API_KEY=
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3

# Web (Vercel) feature flag — non-secret. Default off until worker Go C is live.
FIGURINE_3D_ENABLED=

# Figure product flags — exact string "true" enables. Off by default.
# Set on both Vercel (web gates) and the Hetzner worker (job claim gates).
FIGURE_GENERATION_ENABLED=
FIGURE_AR_ENABLED=
FIGURE_PUBLISH_ENABLED=
# Optional staged rollout: comma/space/semicolon-separated Appwrite user ids.
# Empty or unset = all authenticated users may publish (GA).
FIGURE_PUBLISH_ALLOWLIST=

# Local UI only — never set on Vercel. Honored only when NODE_ENV=development.
BYPASS_QUOTA=
BYPASS_CREDITS=

# Billing — Stripe Checkout for Tripo credit packs.
# STRIPE_CREDITS_PER_PACK is how many credits one successful Checkout grants.
# Do not invent a live price id; set STRIPE_PRICE_ID from the Stripe dashboard.
STRIPE_CREDITS_PER_PACK=

# Worker
WORKER_POLL_INTERVAL_MS=1000
